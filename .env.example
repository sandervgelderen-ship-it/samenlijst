# GEMINI_API_KEY: Required for the AI features (slim toevoegen, lijst kiezen, taken uitwerken).
# AI Studio injects this at runtime from user secrets; locally put it in .env.local.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (Cloud Run service URL in AI Studio).
APP_URL="MY_APP_URL"

# PORT: Optional. Defaults to 3000.
# PORT=3000

# Model override: Optional. Default shown below.
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# VITE_API_URL: Base URL of the deployed server's /api, baked into the Android app at build time.
# The native app has no server of its own, so it calls this one. Can also be changed in the app.
# VITE_API_URL=https://jouw-samenlijst-server.run.app/api
